# Copy this file to .env and fill in your own values. Never commit the real .env.

# NRP (Nautilus Research Platform) OpenAI-compatible endpoint.
# Ask your instructor for the API key if you don't have one.
NRP_API_KEY=sk-your-key-here
NRP_BASE_URL=https://ellm.nrp-nautilus.io/v1

# Which NRP-hosted model to use. Change this one line to switch models
# without touching any code — e.g. set to "glm-5" if "qwen3" is unavailable.
MODEL_NAME=qwen3
