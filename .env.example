# Copy this file to .env and fill in your own values. Never commit the real .env.

# NRP (Nautilus Research Platform) OpenAI-compatible endpoint.
# Ask your instructor for the API key if you don't have one.
NRP_API_KEY=sk-your-key-here
NRP_BASE_URL=https://ellm.nrp-nautilus.io/v1

# Which NRP-hosted model to use. Change this one line to switch models
# without touching any code — e.g. set to "glm-5" if "qwen3" is unavailable.
MODEL_NAME=qwen3-small

# Optional: set to "on" to let qwen3 models "think" before answering.
# Off by default - thinking made analysis ~10x slower with no quality gain.
# LLM_THINKING=off

# Optional: Jira task assignment (python agent.py <transcript> --jira).
# Needs the mcp-atlassian MCP server - see jira_client.py for install steps.
# JIRA_URL=https://your-site.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=your-atlassian-api-token
# JIRA_PROJECT_KEY=TP6
# JIRA_ISSUE_TYPE=Task
# Usually not needed: owners are matched by name against the project's members,
# and anyone not in the project is left unassigned. Only add entries for
# nicknames or shared first names (value = their Jira display name):
# JIRA_USER_MAP=Sam=Samuel Tusick;Jo=Johanna Lee
